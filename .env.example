# Coach — environment configuration
#
# Steps:
#   1. Copy this file to .env  (just duplicate it and rename)
#   2. Fill in GOOGLE_AI_API_KEY  (see README for how to get one — it is free)
#   3. Fill in the four private credentials you received from the maintainer
#   4. Set CHAINLIT_APP_ROOT to the folder where you put this project

# ── Shared infrastructure (already filled in) ───────────────────────────────

STRAVA_API_BASE_URL=https://www.strava.com/api/v3
STRAVA_REDIRECT_URI=http://localhost:8000/oauth/auth/strava/callback
STRAVA_CLIENT_ID=196063

SUPABASE_URL=https://bcrpnxyjktmqktflgzix.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJjcnBueHlqa3RtcWt0Zmxneml4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzMyMTQ3NDEsImV4cCI6MjA4ODc5MDc0MX0.G6lQrfd_U1DvA_MzcbN6Py_PhjFC0xEWqqrq7xUne7A

OAUTH_GOOGLE_CLIENT_ID=924679817191-ouclap7duv9e10eqpeuki2hk8bp1uuma.apps.googleusercontent.com

# ── Private credentials (get these from the maintainer) ─────────────────────

OAUTH_GOOGLE_CLIENT_SECRET=
STRAVA_CLIENT_SECRET=
SUPABASE_SECRET_KEY=
CHAINLIT_AUTH_SECRET=

# ── Your Google AI Studio key ────────────────────────────────────────────────
# Get yours free at https://aistudio.google.com/apikey — takes about 30 seconds.
# Paste the key after the = sign, no quotes needed.

GOOGLE_AI_API_KEY=

# ── Your local project path ──────────────────────────────────────────────────
# Set this to the folder where you saved this project.
# Windows example:  CHAINLIT_APP_ROOT=C:\Users\YourName\Documents\coach
# Mac example:      CHAINLIT_APP_ROOT=/Users/yourname/Documents/coach
# Linux example:    CHAINLIT_APP_ROOT=/home/yourname/Documents/coach

CHAINLIT_APP_ROOT=
